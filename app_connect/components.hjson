{
  components: [
    {
      type: 'dmx-lucide-icon',
      selector: 'dmx-lucide-icon, [is=dmx-lucide-icon]',
      groupTitle: 'Lucide',
      groupIcon: 'fa fa-lg fa-icons',
      title: 'Lucide Icon: @@id@@',
      icon: 'fa fa-lg fa-icons',
      state: 'opened',
      anyParent: true,
      template: '<dmx-lucide-icon id="@@id@@" icon="menu"></dmx-lucide-icon>',
      baseName: 'lucide',
      help: 'Render a Lucide icon. Enter the icon name manually in kebab-case, for example menu, settings, arrow-right, or circle-help.',
      properties: [
        {
          group: 'Lucide Icon Properties',
          variables: [
            { name: 'iconId', attribute: 'id', title: 'ID', type: 'text', defaultValue: '', required: true },
            { name: 'iconName', attribute: 'icon', title: 'Icon Name', type: 'text', defaultValue: 'menu', required: true, help: 'Lucide icon name in kebab-case, for example menu, settings, arrow-right, circle-help.' },
            { name: 'iconSize', attribute: 'size', title: 'Size', type: 'text', defaultValue: '24', help: 'Icon width and height in pixels. Enter a number, for example 24 or 32.' },
            { name: 'iconColor', attribute: 'color', title: 'Color', type: 'text', defaultValue: 'currentColor', help: 'Any CSS color, for example currentColor, #0d6efd, rgb(10, 20, 30), or var(--bs-primary).' },
            { name: 'iconStrokeWidth', attribute: 'stroke-width', title: 'Stroke Width', type: 'text', defaultValue: '2', help: 'SVG stroke width. Enter a number, for example 1.5, 2, or 3.' },
            { name: 'iconLabel', attribute: 'label', title: 'Accessible Label', type: 'text', defaultValue: '', help: 'Optional label for meaningful icons. Leave empty for decorative icons.' }
          ]
        }
      ],
      children: [],
      allowed_children: {},
      copyFiles: [
        { src: 'includes/dmx-lucide-icon.js', dst: 'js/dmx-lucide-icon.js' }
      ],
      linkFiles: [
        { src: 'https://unpkg.com/lucide@1.8.0/dist/umd/lucide.min.js', type: 'js', defer: true },
        { src: 'js/dmx-lucide-icon.js', type: 'js', defer: true }
      ],
      cssOrder: [],
      jsOrder: [
        'https://unpkg.com/lucide@1.8.0/dist/umd/lucide.min.js',
        'js/dmx-lucide-icon.js'
      ]
    }
  ],
  attributes: [],
  events: [],
  static_events: []
}
